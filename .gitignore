# Ignorar archivos y carpetas del sistema/IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Ignorar archivos de entorno (secretos)
.env
.env.*
!.env.example

# Frontend (React/Vite/Node)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.npm/
frontend/.eslintcache
frontend/coverage/

# Backend (Python/FastAPI)
backend/__pycache__/
__pycache__/
*.pyc
*.pyo
backend/venv/
backend/env/
venv/
env/
backend/.pytest_cache/
backend/alembic.ini

# Bases de datos y archivos generados (CRÍTICO: No subir datos de usuarios)
*.db
*.sqlite3
*.db-journal
backend/*.db
backend/*.sqlite3

# Archivos de usuario subidos (Imágenes de perfil, etc.)
backend/uploads/*
!backend/uploads/.keep
